# Names only. Real values live in .env.local (gitignored) and in Vercel.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Must be sk_test_ locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_MONTHLY=

# Email
RESEND_API_KEY=
# Signs unsubscribe links. Without it reminders fail rather than go out with no
# link. Changing it kills the links in every email already sent.
EMAIL_UNSUBSCRIBE_SECRET=

# Protects the cron routes. Vercel Cron sends it as a Bearer token.
CRON_SECRET=

# Retention sweep. Only "true" deletes; anything else makes the cron count and
# delete nothing. Set it only after reading the dry-run counts.
RETENTION_ENABLED=

# Billing reconciliation. Only "true" cancels and refunds subscriptions whose
# account is gone; anything else makes the cron count and change nothing.
BILLING_RECONCILE_ENABLED=

# The live origin. Links in emails and Stripe redirects use it.
NEXT_PUBLIC_SITE_URL=

# Off unless the Google provider is on in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=
